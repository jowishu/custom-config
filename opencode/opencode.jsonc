{
  "__$schema": "https://opencode.ai/config.json",
  "model": "tokenverse/glm-5-3",
  "disabled_providers": ["huggingface"],
  "provider": {
    // tokenverse 模型配置
    "tokenverse": {
      "models": {
        "glm-5-3": { "name": "glm-5-3" }
      },
      "name": "tokenverse",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:TOKENVERSE_API_KEY}",
        "baseURL": "https://tokenverse.corp.kuaishou.com/v1"
      }
    },
    // tokenverse plan 模型配置
    "tokenverse-plan": {
      "models": {
        "gpt-5-6-sol": { "name": "gpt-5-6-sol" },
        "claude-opus-4-8": { "name": "claude-opus-4-8" },
        "claude-opus-5": { "name": "claude-opus-5" }
      },
      "name": "tokenverse-plan",
      "npm": "@ai-sdk/openai",
      "options": {
        "apiKey": "{env:TOKENVERSE_PLAN_API_KEY}",
        "baseURL": "https://tokenverse.corp.kuaishou.com/v1"
      }
    },
    // tokenverse prod 模型配置
    "tokenverse-prod": {
      "models": {
        "gpt-5-6-sol": { "name": "gpt-5-6-sol" },
        "claude-opus-4-8": { "name": "claude-opus-4-8" },
        "claude-opus-5": { "name": "claude-opus-5" }
      },
      "name": "tokenverse-prod",
      "npm": "@ai-sdk/openai",
      "options": {
        "apiKey": "{env:TOKENVERSE_PROD_API_KEY}",
        "baseURL": "https://tokenverse.corp.kuaishou.com/v1"
      }
    }
  }
}
