{
  "$schema": "https://opencode.ai/config.json",
  "model": "tokenverse-plan/glm-5-3",
  "providers": {
    // tokenverse plan 模型配置
    "tokenverse-plan": {
      "name": "TokenversePlan",
      "env": ["TOKENVERSE_PLAN_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://tokenverse.corp.kuaishou.com/v1"
      },
      "models": {
        "glm-5-3": {
          "name": "GLM-5-3",
          "modelID": "glm-5-3"
        }
      }
    },
    // tokenverse prod 模型配置
    "tokenverse-prod": {
      "name": "TokenverseProd",
      "env": ["TOKENVERSE_PROD_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://tokenverse.corp.kuaishou.com/v1"
      },
      "models": {
        "glm-5-3": {
          "name": "GLM-5-3",
          "modelID": "glm-5-3"
        }
      }
    }
  }
}
